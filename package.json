{
  "name": "adzhub-microkernel-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Protótipo do Microkernel Agêntico PEV-C para o domínio de marketing da AdzHub",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @adzhub/web",
    "start": "npm run start -w @adzhub/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
