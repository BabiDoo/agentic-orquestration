# ============================================================
# AdzHub Microkernel PEV-C — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha seus valores.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).
# ============================================================

# ----------------------------------------------------------
# OpenRouter API Key (BYOK - Bring Your Own Key)
# Obtenha em: https://openrouter.ai/keys
# Formato: sk-or-v1-...
# ----------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-SUBSTITUA_PELA_SUA_CHAVE_REAL

# ----------------------------------------------------------
# Modelo padrão para testes com LLM real
# Opções suportadas pela allowlist:
#   anthropic/claude-3-5-sonnet
#   openai/gpt-4o-mini
#   google/gemini-2.5-flash
#   google/gemini-2.0-flash
#   meta-llama/llama-3.1-8b-instruct:free
# ----------------------------------------------------------
OPENROUTER_MODEL=openai/gpt-4o-mini

# ----------------------------------------------------------
# Modo de execução dos testes
# "mock"  → sem API key, deterministico (padrão, rápido)
# "live"  → usa LLM real via OpenRouter (lento, consome crédito)
# ----------------------------------------------------------
TEST_MODE=mock

# ----------------------------------------------------------
# Timeout (ms) para testes com LLM real
# Padrão: 60000 (60s). Aumente para modelos mais lentos.
# ----------------------------------------------------------
LIVE_TEST_TIMEOUT_MS=60000

# ----------------------------------------------------------
# Cenários a executar nos testes live (separados por vírgula)
# Opções: S0, S1, S2, S3, S4, S5, ALL
# ----------------------------------------------------------
LIVE_TEST_SCENARIOS=S0,S1,S5
